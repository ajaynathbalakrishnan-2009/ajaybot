# Server-side secrets. Never commit a real .env file.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Optional model overrides. Defaults match current documented provider model IDs.
GEMINI_FLAGSHIP_MODEL=gemini-3.8-flash
GEMINI_BALANCED_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.7-flash
ANTHROPIC_FLAGSHIP_MODEL=claude-opus-5
ANTHROPIC_BALANCED_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PRO_MODEL=claude-sonnet-5
OPENROUTER_FLAGSHIP_MODEL=openrouter/free
OPENROUTER_BALANCED_MODEL=openrouter/free
OPENROUTER_FAST_MODEL=openrouter/free
OPENROUTER_PRO_MODEL=openrouter/free

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FLAGSHIP_MODEL=qwen3:8b
OLLAMA_BALANCED_MODEL=qwen3:4b
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_PRO_MODEL=qwen3:8b

OLLAMA_ENABLED=true

# Supabase Auth
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
